<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material You dynamic colors (Android 12+) -->
    <!-- Widget background: darkest neutral from user's wallpaper palette -->
    <color name="widget_bg">@android:color/system_neutral1_900</color>
    <!-- Button background: slightly lighter neutral -->
    <color name="widget_btn_bg">@android:color/system_neutral2_800</color>
    <color name="widget_btn_stroke">@android:color/system_neutral2_700</color>
    <!-- OK button: user's primary accent -->
    <color name="widget_ok_bg">@android:color/system_accent1_300</color>
    <!-- Icon color: light neutral -->
    <color name="widget_icon_color">@android:color/system_neutral1_100</color>
    <!-- Title text: light neutral -->
    <color name="widget_title_color">@android:color/system_neutral1_50</color>
    <!-- OK button text: dark accent for contrast on light accent bg -->
    <color name="widget_ok_text">@android:color/system_accent1_900</color>
</resources>
