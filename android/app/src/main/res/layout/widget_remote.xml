<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:gravity="center">

    <!-- Title (tappable to open app) -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scyphomote"
        android:textColor="#DEFFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- D-Pad -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Up -->
        <ImageView
            android:id="@+id/btn_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_up"
            android:scaleType="center"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Up" />

        <!-- Left / OK / Right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btn_left"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_left"
                android:scaleType="center"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Left" />

            <TextView
                android:id="@+id/btn_ok"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="OK"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/widget_ok_btn_bg"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:contentDescription="Select" />

            <ImageView
                android:id="@+id/btn_right"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_right"
                android:scaleType="center"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Right" />
        </LinearLayout>

        <!-- Down -->
        <ImageView
            android:id="@+id/btn_down"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_down"
            android:scaleType="center"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Down" />
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:scaleType="center"
            android:background="@drawable/widget_playback_btn_bg"
            android:contentDescription="Back" />

        <ImageView
            android:id="@+id/btn_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_play_pause"
            android:scaleType="center"
            android:background="@drawable/widget_playback_btn_bg"
            android:layout_marginLeft="8dp"
            android:contentDescription="Play/Pause" />

        <ImageView
            android:id="@+id/btn_stop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_stop"
            android:scaleType="center"
            android:background="@drawable/widget_playback_btn_bg"
            android:layout_marginLeft="8dp"
            android:contentDescription="Stop" />
    </LinearLayout>

</LinearLayout>
